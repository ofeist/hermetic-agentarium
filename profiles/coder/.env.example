# Hermes coder profile local runtime environment
# Copy or symlink to ~/.hermes/profiles/coder/.env (created by install-coder-profile.sh)
# This file is local runtime config — do not commit the real .env

OPENCODE_XDG_CONFIG_HOME=
OPENCODE_XDG_DATA_HOME=
AGENTOPS_EXECUTOR_MODEL=deepseek/deepseek-v4-pro

# Optional provider API keys (uncomment and set as needed):
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
